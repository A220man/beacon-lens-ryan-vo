# beacon-lens environment configuration
# Copy to .env and fill in values

# Application
APP_NAME=beacon-lens
APP_ENV=development
DEMO_MODE=true
LOG_LEVEL=INFO

# Database (SQLite file path)
DATABASE_URL=sqlite+aiosqlite:///./beacon_lens.db

# Security
SECRET_KEY=change-me-in-production-use-32-bytes-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ComfyUI
COMFYUI_URL=http://localhost:8188
COMFYUI_TIMEOUT=300

# LLM (optional, for advisory explanations)
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=beacon-lens
KEYCLOAK_CLIENT_ID=beacon-lens-frontend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=beacon-lens
VITE_KEYCLOAK_CLIENT_ID=beacon-lens-frontend